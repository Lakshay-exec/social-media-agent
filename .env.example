# ============================================================
#  .env.example -- Template for Local Development
#  Never commit your actual .env to GitHub!
# ============================================================

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Threads API Credentials
THREADS_ACCESS_TOKEN=your_threads_long_lived_user_token
THREADS_USER_ID=your_threads_numeric_user_id

# Instagram Graph API Credentials
IG_ACCESS_TOKEN=your_instagram_user_access_token
IG_USER_ID=your_instagram_business_account_id

# Meta App Credentials (For automated 60-day token exchange)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
